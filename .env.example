# dev = mocks, local = local Supabase, prod = hosted Supabase
APP_ENV=dev
BACKEND_BASE_URL=
# For a USB-connected Android device, run `adb reverse tcp:54321 tcp:54321`
# and use http://127.0.0.1:54321 with the local publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
AUTH_REDIRECT_URL=yapchat://login-callback/
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_OF_SERVICE_URL=https://example.com/terms
